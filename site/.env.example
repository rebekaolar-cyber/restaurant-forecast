# Copy to .env for local work. Never put secret keys here: this site only
# ever holds values that are safe to show to visitors.

# Leave unset (or "false") while the site is a test version: every page then
# carries a "testversie" banner and asks search engines not to index it.
# Set to "true" only when this site replaces the official one.
PUBLIC_SITE_LIVE=false
