---
import { nl as t } from '../content/nl';
import { restaurant } from '../content/restaurant';
import logo from '../assets/brand/habibi-logo-black.svg?url';

const path = Astro.url.pathname;
const links = [
  { href: '/menu/', label: t.nav.menu },
  { href: '/over-ons/', label: t.nav.about },
  { href: '/contact/', label: t.nav.contact },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <img src={logo} width="352" height="100" alt={t.logoAlt} />
    </a>
    <a class="button button--small reserve" href={restaurant.bookingUrl}>{t.reserve.short}</a>
    <nav class="nav" aria-label={t.nav.label}>
      <ul role="list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'logo reserve'
      'nav nav';
    align-items: center;
    column-gap: 1rem;
    padding-top: 1rem;
  }

  .logo {
    grid-area: logo;
    justify-self: start;
    display: block;
    padding-block: 0.25rem;
  }

  .logo img {
    width: auto;
    height: 2.75rem;
  }

  .reserve {
    grid-area: reserve;
  }

  .nav {
    grid-area: nav;
    margin-top: 0.5rem;
    margin-inline: -0.625rem;
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
  }

  .nav a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding-inline: 0.625rem;
    text-decoration: none;
  }

  .nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--magenta);
    text-decoration-thickness: 2px;
  }

  /* The magenta dot marks the page you are on. */
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.3rem;
    width: 0.4rem;
    height: 0.4rem;
    margin-left: -0.2rem;
    border-radius: 50%;
    background: var(--magenta);
  }

  @media (max-width: 21.5rem) {
    .logo img {
      height: 2.25rem;
    }
  }

  @media (min-width: 52rem) {
    .bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'logo nav reserve';
      column-gap: 2.5rem;
      padding-block: 1.25rem;
    }

    .logo img {
      height: 3.5rem;
    }

    .nav {
      margin: 0;
      justify-self: end;
    }

    .nav ul {
      gap: 0.75rem;
    }
  }
</style>
