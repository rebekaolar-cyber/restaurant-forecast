---
// The week as seven evenings on one time line. The bars show at a glance
// that Sunday starts earlier and that Friday and Saturday run past midnight.
// The times are also written out as text, so nothing depends on the drawing.
import { week, axis, clock, range } from '../content/hours';
import { nl as t } from '../content/nl';

const { start, end, ticks } = axis();
const x = (minutes: number) => ((minutes - start) / (end - start)) * 100;
---

<div class="hours">
  <div class="row axis" aria-hidden="true">
    <div class="scale">
      {ticks.map((tick, i) => <span>{i % 2 === 0 ? clock(tick) : ''}</span>)}
    </div>
  </div>
  <ul role="list">
    {
      week.map((day, i) => (
        <li class="row" data-day={i}>
          <span class="day">
            {t.days[i]}{' '}
            <span class="now" data-now />
          </span>{' '}
          <span class="time">{range(day)}</span>
          <svg class="track" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            {ticks.map((tick) => <line class="tick" x1={x(tick)} x2={x(tick)} y1="0" y2="10" />)}
            <rect class="bar" x={x(day.open)} y="3" width={x(day.close) - x(day.open)} height="4" />
          </svg>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .hours {
    max-width: 44rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'day time'
      'track track';
    align-items: baseline;
    column-gap: 1rem;
    padding-block: 0.7rem 0.85rem;
    border-top: 1px solid var(--line);
  }

  .day {
    grid-area: day;
  }

  .time {
    grid-area: time;
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
  }

  .track {
    grid-area: track;
    width: 100%;
    height: 0.625rem;
    margin-top: 0.45rem;
    overflow: visible;
  }

  .tick {
    stroke: var(--line);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .bar {
    fill: var(--ink);
  }

  /* The axis sits above the first row and lines up with the tracks. */
  .axis {
    border-top: 0;
    padding-block: 0 0.4rem;
  }

  .scale {
    grid-area: track;
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .scale span {
    display: flex;
    justify-content: center;
    width: 0;
    white-space: nowrap;
  }

  .scale span:first-child {
    justify-content: flex-start;
  }

  .scale span:last-child {
    justify-content: flex-end;
  }

  /* Today: the script in scripts/today.ts sets aria-current on one row and
     writes "(vandaag)" or "(nu open)" into its marker. */
  .now {
    display: none;
    margin-left: 0.25em;
    color: var(--muted);
    font-size: var(--small);
  }

  .row[aria-current='date'] .day {
    font-weight: 500;
  }

  .row[aria-current='date'] .day::before {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-right: 0.5em;
    border-radius: 50%;
    background: var(--magenta);
    vertical-align: 0.08em;
  }

  .row[aria-current='date'] .now {
    display: inline;
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 11rem 1fr 8.5rem;
      grid-template-areas: 'day track time';
      align-items: center;
      column-gap: 1.5rem;
      padding-block: 0.8rem;
    }

    .track {
      margin-top: 0;
    }

    .time {
      text-align: right;
    }
  }
</style>
