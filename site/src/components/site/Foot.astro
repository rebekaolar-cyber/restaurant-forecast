---
// The footer of every page: the motto and a reserve button, contact details,
// map, opening hours, social media and the page links.
import Logo from './Logo.astro';
import Hours from './Hours.astro';
import MapLink from './MapLink.astro';
import Orn from './Orn.astro';
import { restaurant } from '../../content/restaurant';
import { href, t, type Lang } from '../../content/i18n';
import { copy } from '../../content/pages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang];
---

<footer class="room room--ink foot">
  <div class="wrap foot__motto">
    <p class="motto">{t(lang, 'Kom als gast, ga als habibi.')}</p>
    <a class="btn" href={restaurant.bookingUrl} rel="noopener">
      {t(lang, 'Reserveren')}
      <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h13M10 4l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
    </a>
  </div>
  <div class="wrap foot__grid">
    <div class="foot__logo"><Logo label="Restaurant Habibi, the taste of Lebanon" /></div>
    <div class="foot__contact">
      <strong>{t(lang, 'Contact')}</strong>
      <address>
        <p><bdi>{restaurant.name}</bdi><br /><bdi>{restaurant.street}</bdi><br /><bdi>{restaurant.postcode} {restaurant.city}</bdi></p>
        <p>
          <a class="foot__a" href={`tel:${restaurant.phoneIntl}`} dir="ltr">{restaurant.phone}</a><br />
          <a class="foot__a" href={`mailto:${restaurant.email}`} dir="ltr">{restaurant.email}</a>
        </p>
      </address>
      <MapLink lang={lang} />
    </div>
    <div class="foot__hours">
      <strong>{t(lang, 'Openingstijden')}</strong>
      <Hours lang={lang} />
    </div>
    <div class="foot__social">
      <strong>{t(lang, 'Volg ons')}</strong>
      <ul>
        <li>
          <a class="social" href={restaurant.instagram} rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17" cy="7" r=".6"></circle></svg>Instagram
          </a>
        </li>
        <li>
          <a class="social" href={restaurant.facebook} rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M13 20.5v-8h2.6M10.4 12.5H13V10c0-1.4.8-2.3 2.3-2.3h.7"></path></svg>Facebook
          </a>
        </li>
        <li>
          <a class="social" href={restaurant.tiktok} rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3.5v11.2a3.8 3.8 0 1 1-3.8-3.8"></path><path d="M14 3.5c.4 2.6 2.4 4.6 5 5"></path></svg>TikTok
          </a>
        </li>
      </ul>
    </div>
  </div>
  <nav class="wrap" aria-label={c.pagesNav}>
    <ul class="foot__pages">
      <li><a href={href(lang, 'home')}>{t(lang, 'Home')}</a></li>
      <li><a href={href(lang, 'menu')}>{t(lang, 'Menu')}</a></li>
      <li><a href={href(lang, 'about')}>{t(lang, 'Over ons')}</a></li>
      <li><a href={href(lang, 'contact')}>{t(lang, 'Contact')}</a></li>
      <li><a href={href(lang, 'privacy')}>{c.meta.privacy.title}</a></li>
      <li><a href="/login/" rel="nofollow">{c.staffLogin}</a></li>
    </ul>
  </nav>
  <div class="foot__orn"><Orn turn /></div>
</footer>
