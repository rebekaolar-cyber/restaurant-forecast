---
import { nl as t } from '../content/nl';
import { restaurant } from '../content/restaurant';
import { grouped, range } from '../content/hours';
import logo from '../assets/brand/habibi-logo-round.svg?url';

const year = new Date().getFullYear();
const links = [
  { href: '/menu/', label: t.nav.menu },
  { href: '/over-ons/', label: t.nav.about },
  { href: '/contact/', label: t.nav.contact },
  { href: '/privacy/', label: t.nav.privacy },
];
const label = (from: number, to: number) =>
  from === to
    ? t.daysShort[from]
    : `${t.daysShort[from]} ${t.footer.through} ${t.daysShort[to]?.toLowerCase()}`;
---

<footer class="site-footer">
  <div class="wrap grid">
    <img class="mark" src={logo} width="176" height="176" alt={t.logoAlt} loading="lazy" decoding="async" />

    <div>
      <h2>{t.address.title}</h2>
      <address>
        {restaurant.street}<br />
        {restaurant.postcode} {restaurant.city}
      </address>
      <p><a class="link" href={restaurant.mapUrl}>{t.address.map}</a></p>
    </div>

    <div>
      <h2>{t.hours.title}</h2>
      <ul role="list" class="times">
        {
          grouped().map((g) => (
            <li>
              <span>{label(g.from, g.to)}</span>
              <span>{range(g.hours)}</span>
            </li>
          ))
        }
      </ul>
      <p class="status dot" data-today-line>{t.hours.everyDay}</p>
    </div>

    <nav aria-label={t.footer.navLabel}>
      <h2>{t.footer.navLabel}</h2>
      <ul role="list">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        <li><a href={restaurant.bookingUrl}>{t.reserve.button}</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <p>© {year} {restaurant.name}</p>
    <a href="/login/" rel="nofollow">{t.footer.staff}</a>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 2rem + 5vw, 5rem) 2rem;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--small);
    line-height: 1.6;
  }

  .grid {
    display: grid;
    gap: 2.25rem;
  }

  .mark {
    width: 9.5rem;
    height: 9.5rem;
    margin-left: -0.75rem;
  }

  h2 {
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    letter-spacing: 0;
  }

  nav a {
    display: inline-block;
    padding-block: 0.55rem;
  }

  nav li + li {
    margin-top: -0.2rem;
  }

  .times li {
    display: flex;
    gap: 1rem;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .times li span:first-child {
    min-width: 6.25rem;
  }

  .status {
    margin-top: 0.6rem;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    margin-top: 3rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--pattern);
    color: #cfcacb;
  }

  .legal a {
    display: inline-block;
    padding-block: 0.55rem;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .mark {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 62rem) {
    .grid {
      grid-template-columns: 14rem repeat(3, 1fr);
      column-gap: 3rem;
    }

    .mark {
      grid-column: auto;
      width: 11rem;
      height: 11rem;
    }
  }
</style>
