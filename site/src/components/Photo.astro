---
// One photo slot. Shows the photo when photos.ts has one, otherwise a marked
// placeholder of the same shape, so the layout does not move when it arrives.
import { Image } from 'astro:assets';
import { photos, type PhotoName } from '../content/photos';
import { nl as t } from '../content/nl';

interface Props {
  name: PhotoName;
  ratio?: '4x5' | '3x2' | '1x1' | '16x9';
  /** How wide the photo is shown, for choosing the right file size. */
  sizes?: string;
  /** First photo on the page: load straight away. */
  eager?: boolean;
}

const { name, ratio = '3x2', sizes = '100vw', eager = false } = Astro.props;
const photo = photos[name];
---

{
  photo.src ? (
    <Image
      class={`photo photo--${ratio}`}
      src={photo.src}
      alt={photo.alt}
      widths={[480, 800, 1200, 1800]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
  ) : (
    <div class={`photo photo--${ratio} photo--empty placeholder`}>
      <p>
        <span class="placeholder__tag">{t.placeholder.tag}</span> {photo.wanted}
      </p>
    </div>
  )
}

<style>
  .photo {
    display: block;
    width: 100%;
  }

  img.photo {
    object-fit: cover;
    background: var(--mist);
  }

  .photo--4x5 {
    aspect-ratio: 4 / 5;
  }

  .photo--3x2 {
    aspect-ratio: 3 / 2;
  }

  .photo--1x1 {
    aspect-ratio: 1;
  }

  .photo--16x9 {
    aspect-ratio: 16 / 9;
  }

  .photo--empty {
    display: flex;
    align-items: flex-end;
  }

  .photo--empty p {
    max-width: 26rem;
  }
</style>
