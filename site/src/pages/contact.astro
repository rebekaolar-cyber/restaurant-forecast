---
import Base from '../layouts/Base.astro';
import OpeningHours from '../components/OpeningHours.astro';
import Placeholder from '../components/Placeholder.astro';
import { nl as t } from '../content/nl';
import { restaurant } from '../content/restaurant';

const page = t.contact;
const tel = restaurant.phone?.replace(/[^+\d]/g, '');
---

<Base title={page.title} description={page.description}>
  <div class="wrap page-head">
    <h1>{page.heading}</h1>
  </div>

  <div class="wrap blocks">
    <section>
      <h2>{t.address.title}</h2>
      <address>
        {restaurant.name}<br />
        {restaurant.street}<br />
        {restaurant.postcode} {restaurant.city}
      </address>
      <p><a class="link" href={restaurant.mapUrl}>{t.address.map}</a></p>
      <p class="small muted">{t.address.mapNote}</p>
    </section>

    <section>
      <h2>{page.reserveTitle}</h2>
      <p><a class="button" href={restaurant.bookingUrl}>{t.reserve.button}</a></p>
      <p class="small muted">{t.reserve.note}</p>
    </section>

    <section>
      <h2>{page.reachTitle}</h2>
      {
        restaurant.phone || restaurant.email ? (
          <dl class="reach">
            {restaurant.phone && (
              <div>
                <dt>{page.phone}</dt>
                <dd><a href={`tel:${tel}`}>{restaurant.phone}</a></dd>
              </div>
            )}
            {restaurant.email && (
              <div>
                <dt>{page.email}</dt>
                <dd><a href={`mailto:${restaurant.email}`}>{restaurant.email}</a></dd>
              </div>
            )}
          </dl>
        ) : (
          <Placeholder>{page.reachWanted}</Placeholder>
        )
      }
    </section>
  </div>

  <section class="band band--mist hours">
    <div class="wrap">
      <h2>{t.hours.title}</h2>
      <p class="status dot" data-today-line>{t.hours.everyDay}</p>
      <OpeningHours />
    </div>
  </section>
</Base>

<style>
  .blocks {
    display: grid;
    gap: 2.75rem;
    padding-bottom: var(--section);
  }

  .blocks h2 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.5rem, 1.35rem + 0.7vw, 1.875rem);
  }

  .blocks p {
    margin-top: 0.6rem;
  }

  .reach > div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    padding-block: 0.25rem;
  }

  .reach dt {
    color: var(--muted);
  }

  .hours h2 {
    margin-bottom: 0.75rem;
  }

  .status {
    margin-bottom: 2rem;
    font-weight: 500;
  }

  @media (min-width: 52rem) {
    .blocks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(2rem, 5vw, 4.5rem);
    }
  }
</style>
