---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Placeholder from '../components/Placeholder.astro';
import { nl as t } from '../content/nl';
import { restaurant } from '../content/restaurant';
import { sections, euro } from '../content/menu';

const page = t.menu;
const hasMenu = sections.length > 0;
---

<Base title={page.title} description={page.description}>
  <div class="wrap page-head">
    <h1>{page.heading}</h1>
  </div>

  <div class="wrap menu">
    {
      hasMenu ? (
        sections.map((section) => (
          <section class="section">
            <h2>{section.title}</h2>
            {section.note && <p class="muted">{section.note}</p>}
            <ul role="list" class="items">
              {section.items.map((item) => (
                <li class="item">
                  <h3 class="item__name">{item.name}</h3>
                  {item.price !== undefined && <p class="item__price">{euro(item.price)}</p>}
                  {item.description && <p class="item__text muted">{item.description}</p>}
                </li>
              ))}
            </ul>
          </section>
        ))
      ) : (
        <>
          <Placeholder>{page.empty.wanted}</Placeholder>
          <p class="meanwhile">
            {page.empty.meanwhile} <a href={restaurant.currentWebsite}>{restaurant.currentWebsiteLabel}</a>.
          </p>

          <section class="section sample placeholder" aria-label={page.empty.layoutTitle}>
            <p>
              <span class="placeholder__tag">{t.placeholder.tag}</span> {page.empty.layoutTitle}
            </p>
            <h2>{page.empty.sampleSection}</h2>
            <ul role="list" class="items">
              {[1, 2, 3].map(() => (
                <li class="item">
                  <h3 class="item__name">{page.empty.sampleItem}</h3>
                  <p class="item__price">{page.empty.samplePrice}</p>
                  <p class="item__text muted">{page.empty.sampleDescription}</p>
                </li>
              ))}
            </ul>
          </section>
        </>
      )
    }
  </div>

  <div class="wrap band menu-photo">
    <Photo name="menu" ratio="16x9" sizes="(min-width: 74rem) 74rem, 100vw" />
  </div>

  <div class="wrap reserve">
    <a class="button" href={restaurant.bookingUrl}>{t.reserve.button}</a>
    <p class="small muted">{t.reserve.note}</p>
  </div>
</Base>

<style>
  .menu {
    display: grid;
    gap: 2rem;
  }

  .menu > :global(*) {
    max-width: 44rem;
  }

  .section + .section {
    margin-top: 2rem;
  }

  .section h2 {
    margin-bottom: 0.5rem;
  }

  .items {
    margin-top: 1rem;
  }

  .item {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1.5rem;
    align-items: baseline;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }

  .item__name {
    font-size: 1.375rem;
  }

  .item__price {
    font-variant-numeric: lining-nums tabular-nums;
    white-space: nowrap;
  }

  .item__text {
    grid-column: 1;
    margin-top: 0.15rem;
    font-size: var(--small);
    line-height: 1.5;
  }

  /* The sample block shows the layout only. Its rows are not dishes. */
  .sample {
    padding: 1.25rem;
    font-size: var(--text);
  }

  .sample > p {
    margin-bottom: 1.5rem;
    font-size: var(--small);
  }

  .sample .item {
    border-top-color: #cfc9cb;
  }

  .menu-photo {
    padding-bottom: 0;
  }

  .reserve {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    padding-block: 3rem var(--section);
  }
</style>
