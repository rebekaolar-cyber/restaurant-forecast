---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { nl as t } from '../content/nl';
import { restaurant } from '../content/restaurant';
import serifFont from '../assets/fonts/brygada-1918-latin-wght-normal.woff2?url';
import sansFont from '../assets/fonts/alegreya-sans-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Use the title exactly as given (home page). */
  bareTitle?: boolean;
  /** Always keep this page out of search engines (login, dashboard, 404). */
  noindex?: boolean;
}

const { title, description, bareTitle = false, noindex = false } = Astro.props;

// Until PUBLIC_SITE_LIVE is "true" this is a test version: every page shows a
// banner pointing to the official website and asks search engines to stay away.
const live = import.meta.env.PUBLIC_SITE_LIVE === 'true';
const fullTitle = bareTitle ? title : `${title} | ${t.siteName}`;
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {(!live || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#231f20" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
  </head>
  <body>
    <a class="skip" href="#inhoud">{t.nav.skip}</a>
    {
      !live && (
        <p class="test-banner">
          {t.testBanner.text}{' '}
          <a href={restaurant.currentWebsite}>{restaurant.currentWebsiteLabel}</a>.
        </p>
      )
    }
    <Header />
    <main id="inhoud">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/auth-handoff';
      import '../scripts/today';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 0.75rem;
    top: -4rem;
    z-index: 10;
    padding: 0.6rem 1rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 0 0 0.5rem 0.5rem;
  }

  .skip:focus {
    top: 0;
  }

  .test-banner {
    padding: 0.5rem var(--gutter);
    background: var(--mist);
    border-bottom: 1px solid var(--line);
    font-size: var(--small);
    line-height: 1.4;
    text-align: center;
  }

  main {
    display: block;
  }
</style>
